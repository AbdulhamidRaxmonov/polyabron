{
    "name": "calorie-bot/telegram-bot",
    "description": "iCalCalorie — полный калорийный счётчик Telegram бот на PHP",
    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-curl": "*",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "migrate": "php database/migrate.php",
        "seed":    "php database/seed.php",
        "setup":   "php setup.php"
    },
    "config": {
        "optimize-autoloader": true
    }
}
